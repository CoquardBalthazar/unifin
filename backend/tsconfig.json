{
  // This is the TYPECHECK config — the one VS Code picks up (it looks for
  // the nearest file literally named `tsconfig.json`, so tests must be in
  // here or they belong to no project and report TS6059).
  // Emitting `dist/` is a separate job: see tsconfig.build.json.
  //
  // Without an explicit `include`, tsc defaults to `**/*` and would also
  // pull in `dist/`.
  "include": ["src", "test", "knexfile.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"],

  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // rootDir spans the whole package so `test/` is legal; harmless
    // because noEmit means nothing is ever written.
    "rootDir": ".",
    "outDir": "./dist",
    "noEmit": true,

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    "noImplicitReturns": true,
    // "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true, //turns on the full bundle of strict type-checks (no implicit any, null-checking, etc.)
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
